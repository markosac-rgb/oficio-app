generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id
  role            String
  name            String
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  authNote        String    @default("")
  isDemo          Boolean   @default(false)
  suspended       Boolean   @default(false)
  acceptedRulesAt            DateTime?
  acceptedLegalVersion       String   @default("")
  acceptedSecondaryPurposes  Boolean  @default(false)
  createdAt       DateTime  @default(now())

  clientProfile   ClientProfile?
  providerProfile ProviderProfile?
  sessions        Session[]
  notifications   Notification[]
  messages        Message[]
  reviews         Review[]
  favorites       Favorite[]
  reports         Report[]         @relation("Reporter")
  requests        ServiceRequest[] @relation("ClientRequests")
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model OtpChallenge {
  id        String   @id
  target    String
  codeHash  String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ClientProfile {
  userId       String  @id
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  street       String  @default("")
  neighborhood String  @default("")
  city         String  @default("")
  state        String  @default("")
  postalCode   String  @default("")
  reference    String  @default("")
  lat          Float   @default(19.4326)
  lng          Float   @default(-99.1332)
  locationSet  Boolean @default(false)
}

model ProviderProfile {
  id                 String  @id
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade              String  @default("")
  bio                String  @default("")
  experienceYears    Int     @default(0)
  coverageKm         Int     @default(8)
  zoneLabel          String  @default("")
  city               String  @default("")
  state              String  @default("")
  postalCode         String  @default("")
  lat                Float   @default(19.4326)
  lng                Float   @default(-99.1332)
  scheduleJson       String  @default("{}")
  availableNow       Boolean @default(false)
  emergency          Boolean @default(false)
  identityStatus     String  @default("none")
  certStatus         String  @default("none")
  referencesStatus   String  @default("none")
  referencesNote     String  @default("")
  mpUserId           String  @default("")
  mpAccessToken      String  @default("")
  mpRefreshToken     String  @default("")
  mpPublicKey        String  @default("")
  mpTokenExpiresAt   DateTime?
  isExample          Boolean @default(false)
  cancellationPolicy String  @default("")
  responseMinutes    Int     @default(40)
  profileReady       Boolean @default(false)

  services  ServiceOffering[]
  photos    WorkPhoto[]
  documents ProviderDocument[]
  quotes    Quote[]
  reviews   Review[]
}

model Category {
  id       String            @id
  name     String
  blurb    String
  icon     String
  sort     Int
  services ServiceOffering[]
  requests ServiceRequest[]
}

model ServiceOffering {
  id          String          @id
  providerId  String
  provider    ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id])
  title       String
  description String
  priceType   String
  priceMxn    Int?
  unit        String

  @@index([providerId])
  @@index([categoryId])
}

model WorkPhoto {
  id         String          @id
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  caption    String
  tone       String
  imageData  String          @default("")
  isExample  Boolean         @default(false)
}

model ProviderDocument {
  id         String          @id
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  kind       String
  label      String
  status     String          @default("pending")
  note       String          @default("")
  createdAt  DateTime        @default(now())
}

model ServiceRequest {
  id                String    @id
  clientId          String
  client            User      @relation("ClientRequests", fields: [clientId], references: [id])
  categoryId        String
  category          Category  @relation(fields: [categoryId], references: [id])
  targetProviderId  String?
  serviceOfferingId String?
  serviceTitle      String    @default("")
  referencePriceMxn Int?
  mode              String
  title             String
  description       String
  photoData         String    @default("[]")
  neighborhood      String
  city              String
  state             String
  postalCode        String
  street            String
  reference         String    @default("")
  lat               Float
  lng               Float
  emergency         Boolean   @default(false)
  preferredWindow   String    @default("")
  status            String
  isExample         Boolean   @default(false)
  scheduledAt       DateTime?
  selectedQuoteId   String?
  cancelReason      String    @default("")
  cancelledBy       String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  quotes   Quote[]
  messages Message[]
  payment  Payment?
  review   Review?
  reports  Report[]

  @@index([clientId])
  @@index([status])
  @@index([targetProviderId])
}

model Quote {
  id         String          @id
  requestId  String
  request    ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  amountMxn  Int
  message    String
  etaMinutes Int?
  status     String
  createdAt  DateTime        @default(now())

  @@index([requestId])
  @@index([providerId])
}

model Message {
  id                 String         @id
  requestId          String
  request            ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User           @relation(fields: [senderId], references: [id])
  body               String
  imageData          String         @default("")
  audienceProviderId String         @default("")
  createdAt          DateTime       @default(now())

  @@index([requestId])
}

model Payment {
  id            String         @id
  requestId     String         @unique
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  method        String
  serviceMxn    Int
  feeMxn        Int
  totalMxn      Int
  status        String
  simulated     Boolean        @default(true)
  adapter       String
  reference         String
  note              String
  policyVersion     String         @default("2026-10")
  externalPaymentId String?        @unique
  preferenceId      String         @default("")
  payee             String         @default("none")
  methodDetail      String         @default("")
  ticketUrl         String         @default("")
  liveMode          Boolean        @default(false)
  createdAt         DateTime       @default(now())
  events            PaymentEvent[]
}

model PaymentEvent {
  id        String   @id
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@unique([paymentId, status])
  @@index([paymentId])
}

model Review {
  id         String          @id
  requestId  String?         @unique
  request    ServiceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String
  author     User            @relation(fields: [authorId], references: [id])
  providerId String
  provider   ProviderProfile @relation(fields: [providerId], references: [id])
  rating     Int
  comment    String
  isExample  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([providerId])
}

model Favorite {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  createdAt  DateTime @default(now())

  @@unique([userId, providerId])
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AppSetting {
  key   String @id
  value String
}

model Report {
  id           String          @id
  reporterId   String
  reporter     User            @relation("Reporter", fields: [reporterId], references: [id])
  requestId    String?
  request      ServiceRequest? @relation(fields: [requestId], references: [id])
  targetUserId String          @default("")
  kind         String
  description  String
  status       String          @default("OPEN")
  adminNote    String          @default("")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status])
}
