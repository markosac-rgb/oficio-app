# PostgreSQL local. En Render, DATABASE_URL es la cadena de Neon (con pooler).
# Ejemplo Neon: postgresql://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://oficio:oficio@127.0.0.1:5432/oficio?schema=public"

# Opcional. Las migraciones usan esta conexión directa, sin pooler.
# Si no la defines, el arranque usa DATABASE_URL.
# Ejemplo Neon: postgresql://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://oficio:oficio@127.0.0.1:5432/oficio?schema=public"

# Mercado Pago (México). Sin MP_ACCESS_TOKEN el pago sigue en modo simulado.
# El token de un usuario de prueba suele empezar con APP_USR-.
MP_ACCESS_TOKEN=""
# 1 fuerza el aviso de prueba y el checkout sandbox. 0 lo apaga.
# Si no se define: token TEST-, o la etiqueta test_user en GET /users/me.
# MP_TEST_MODE=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
# Solo si el proveedor va a conectar su propia cuenta (comisión como marketplace_fee).
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
# Porcentaje de la comisión sobre el precio acordado. 0 si no se define. 10 = 10%.
OFIXIO_COMMISSION_PCT="0"
# URL pública. Hace falta para back_urls, el webhook, OAuth y la app nativa (Capacitor server.url).
OFICIO_PUBLIC_URL="https://oficio-app.onrender.com"

# Avisos push. Sin este JSON, el registro del celular se guarda pero no se envía nada.
# Pega el JSON de la cuenta de servicio de Firebase en una sola línea.
# FCM_SERVICE_ACCOUNT_JSON=""
# 1 manda los avisos de iOS al entorno sandbox de APNs (builds de desarrollo).
# APNS_SANDBOX="0"

# Iniciar sesión con Apple. Si falta cualquiera, el botón no aparece.
# APPLE_CLIENT_ID=""
# APPLE_TEAM_ID=""
# APPLE_KEY_ID=""
# APPLE_PRIVATE_KEY=""
# APPLE_BUNDLE_ID="mx.ofixio.app"
